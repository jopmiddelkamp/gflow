  },
  {
   "phase": "Release 0.1",
   "actor": "gflow",
   "frames": [
    {
     "cmd": "gflow finish   # re-run",
     "text": "gflow creates landing/release-0.1.0-into-develop and merges develop into it. VERSION conflicts. gflow stops mid-merge.",
     "ops": [
      {
       "op": "branch",
       "name": "landing/release-0.1.0-into-develop",
       "from": "release/0.1.0"
