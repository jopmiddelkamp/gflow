{
 "title": "gflow cycle: protected, patch, delete release branches",
 "settings": {
  "mode": "protected",
  "bump-strategy": "patch",
  "keep-release-branches": "false"
 },
 "rules": [
  "main and develop accept changes only through PRs. gflow never merges a landing PR (landing/*); a reviewer merges it with a MERGE COMMIT.",
  "A version change on a branch that already exists on origin travels on version/X.Y.Z-into-<target>. gflow opens the PR and turns on auto-complete with SQUASH. Fallbacks: merge at once, then a human merges.",
  "A new release/* or hotfix/* branch gets its version commit before its first push, in both modes.",
  "Tags: patch cuts a clean vX.Y.Z on the release branch at start and at every bump. The last bump tag is the release; finish adds no tag.",
  "A hotfix gets one tag, on its merge into main.",
  "Finish deletes the release or hotfix branch. Its tags keep the commits."
 ],
 "actions": [
  {
   "phase": "Reset",
   "actor": "tool",
   "frames": [
    {
     "cmd": "resetPlayground()",
     "text": "main and develop point at the first commit. It has .gflow/set-version.sh, VERSION 0.0.0 and .gflow/config with mode=protected, bump-strategy=patch and keep-release-branches=false.",
     "ops": [
      {
       "op": "init",
       "version": "0.0.0"
      }
     ]
    }
   ]
  },
  {
   "phase": "Develop work",
   "actor": "gflow",
   "frames": [
    {
     "cmd": "gflow start feature --name login --no-worktree",
     "text": "gflow creates feature/login from develop and pushes it.",
     "ops": [
      {
       "op": "branch",
       "name": "feature/login",
       "from": "develop"
      }
     ]
    }
   ]
  },
  {
   "phase": "Develop work",
   "actor": "dev",
   "frames": [
    {
     "cmd": "git commit -m \"feat: login\"",
     "text": "The developer commits one file on feature/login.",
     "ops": [
      {
       "op": "commit",
       "branch": "feature/login",
       "message": "feat: login"
      }
     ]
    }
   ]
  },
  {
   "phase": "Develop work",
   "actor": "gflow",
   "frames": [
    {
     "cmd": "gflow finish --base develop --breaking=false",
     "text": "gflow pushes feature/login and opens PR #1 into develop. It asks for a SQUASH merge.",
     "ops": [
      {
       "op": "openPr",
       "pr": 1,
       "from": "feature/login",
       "into": "develop",
       "method": "squash"
      }
     ]
    }
   ]
  },
  {
   "phase": "Develop work",
   "actor": "reviewer",
   "frames": [
    {
     "cmd": "Squash and merge PR #1",
     "text": "The reviewer squash-merges PR #1 into develop.",
     "ops": [
      {
       "op": "squash",
       "from": "feature/login",
       "into": "develop",
       "message": "feat: login (#1)"
      },
      {
       "op": "mergedPr",
       "pr": 1
      }
     ]
    }
   ]
  },
  {
   "phase": "Develop work",
   "actor": "gflow",
   "frames": [
    {
     "cmd": "gflow finish   # re-run",
     "text": "gflow sees the merged PR and deletes feature/login locally and on origin.",
     "ops": [
      {
       "op": "delete",
       "name": "feature/login"
      }
     ]
    }
   ]
  },
  {
   "phase": "Release 0.1",
   "actor": "gflow",
   "frames": [
    {
     "cmd": "gflow start release --minor --no-worktree",
     "text": "gflow cuts release/0.1.0 from develop.",
     "ops": [
      {
       "op": "start",
       "name": "release/0.1.0",
       "from": "develop"
      }
     ]
    },
    {
     "cmd": "gflow start release --minor   # same call",
     "text": "release/0.1.0 is not on origin yet, so no PR is needed. gflow commits VERSION 0.1.0 on it, pushes it and tags that commit v0.1.0.",
     "ops": [
      {
       "op": "commit",
       "branch": "release/0.1.0",
       "message": "chore: set version 0.1.0",
       "version": "0.1.0"
      },
      {
       "op": "tag",
       "name": "v0.1.0",
       "on": "release/0.1.0"
      }
     ]
    }
   ]
  },
  {
   "phase": "Release 0.1",
   "actor": "gflow",
   "frames": [
    {
     "cmd": "gflow start release --minor   # same call",
     "text": "develop is protected, so the version change needs a PR. gflow makes version/0.2.0-into-develop from develop, commits VERSION 0.2.0, opens PR #2 into develop, turns on auto-complete with SQUASH and exits.",
     "ops": [
      {
       "op": "branch",
       "name": "version/0.2.0-into-develop",
       "from": "develop"
      },
      {
       "op": "commit",
       "branch": "version/0.2.0-into-develop",
       "message": "chore: set version 0.2.0",
       "version": "0.2.0"
      },
      {
       "op": "openPr",
       "pr": 2,
       "from": "version/0.2.0-into-develop",
       "into": "develop",
       "method": "squash"
      }
     ]
    }
   ]
  },
  {
   "phase": "Release 0.1",
   "actor": "platform",
   "frames": [
    {
     "cmd": "auto-complete PR #2",
     "text": "The required checks pass. The platform squash-merges PR #2 and deletes version/0.2.0-into-develop. develop now has VERSION 0.2.0.",
     "ops": [
      {
       "op": "squash",
       "from": "version/0.2.0-into-develop",
       "into": "develop",
       "message": "chore: set version 0.2.0 (#2)",
       "version": "0.2.0"
      },
      {
       "op": "mergedPr",
       "pr": 2
      },
      {
       "op": "delete",
       "name": "version/0.2.0-into-develop"
      }
     ]
    }
   ]
  },
  {
   "phase": "Release 0.1",
   "actor": "gflow",
   "frames": [
    {
     "cmd": "gflow start release-fix --name crash --no-worktree",
