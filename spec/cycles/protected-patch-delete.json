       "pr": 3,
       "from": "release-fix/0.1.0/crash",
       "into": "release/0.1.0",
       "method": "squash"
      }
     ]
    }
   ]
  },
  {
   "phase": "Release 0.1",
   "actor": "reviewer",
   "frames": [
    {
     "cmd": "Squash and merge PR #3",
     "text": "The reviewer squash-merges PR #3 into release/0.1.0.",
     "ops": [
      {
       "op": "squash",
       "from": "release-fix/0.1.0/crash",
       "into": "release/0.1.0",
       "message": "fix: crash (#3)"
      },
      {
       "op": "mergedPr",
       "pr": 3
      }
     ]
    }
   ]
  },
  {
   "phase": "Release 0.1",
   "actor": "gflow",
   "frames": [
    {
     "cmd": "gflow finish   # re-run",
